# ==============================================================================
# GD Goenka School Admission CRM - Environment Configuration Template
# ==============================================================================

# Application Environment (use 'production' for live hosting, 'development' for local)
APP_NAME="GD Goenka School Admission CRM"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-school-domain.com

# Database Configuration (MySQL / MariaDB on cPanel / Plesk / VPS)
# Note: You can also configure these directly in app/Config/Database.php
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hosting_database_name
DB_USER=your_hosting_database_username
DB_PASS=your_hosting_database_password
DB_CHARSET=utf8mb4

# Session & Security Settings
SESSION_LIFETIME=7200
CSRF_SECRET="gdg-purnea-super-secure-production-key-2027-28"

# Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp,xlsx,csv
PRIVATE_STORAGE_PATH=storage/private_uploads
